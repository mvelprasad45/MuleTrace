# MULETRACE Configuration
PROJECT_NAME="MULETRACE - AI Fraud Network Investigation"
SECRET_KEY="muletrace-super-secret-cyber-security-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL default, falls back to SQLite if PostgreSQL unreachable)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/muletrace"
SQLITE_FALLBACK_URL="sqlite:///./muletrace.db"

# Evidence Vault storage directory
UPLOAD_DIR="uploads/evidence"
REPORTS_DIR="uploads/reports"

# Demo Mode
DEMO_MODE=True

